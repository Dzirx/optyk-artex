{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/strony/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/moda",
      "destination": "/strony/moda"
    },
    {
      "source": "/soczewki",
      "destination": "/strony/soczewki"
    },
    {
      "source": "/badanie-wzroku",
      "destination": "/strony/badanie-wzroku"
    },
    {
      "source": "/polityka-prywatnosci",
      "destination": "/strony/polityka-prywatnosci"
    },
    {
      "source": "/polityka-cookies",
      "destination": "/strony/polityka-cookies"
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/favicons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
